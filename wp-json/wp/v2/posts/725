comments?post=725"}],"version-history":[{"count":2,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/posts\/725\/revisions"}],"predecessor-version":[{"id":1024,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/posts\/725\/revisions\/1024"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/media\/307"}],"wp:attachment":[{"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/media?parent=725"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/categories?post=725"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/tags?post=725"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}