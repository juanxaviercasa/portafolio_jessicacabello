"],"_links":{"self":[{"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/posts\/676","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/comments?post=676"}],"version-history":[{"count":4,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/posts\/676\/revisions"}],"predecessor-version":[{"id":1018,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/posts\/676\/revisions\/1018"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/media\/289"}],"wp:attachment":[{"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/media?parent=676"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/categories?post=676"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/tags?post=676"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}