a","tag-instrucciones-claras","tag-pnl-aplicada","tag-tercer-grado"],"_links":{"self":[{"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/posts\/681","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/comments?post=681"}],"version-history":[{"count":4,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/posts\/681\/revisions"}],"predecessor-version":[{"id":1019,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/posts\/681\/revisions\/1019"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/media\/292"}],"wp:attachment":[{"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/media?parent=681"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/categories?post=681"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/tags?post=681"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}