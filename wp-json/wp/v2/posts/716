ogjessica.pantheonsite.io\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/comments?post=716"}],"version-history":[{"count":3,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/posts\/716\/revisions"}],"predecessor-version":[{"id":1022,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/posts\/716\/revisions\/1022"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/media\/301"}],"wp:attachment":[{"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/media?parent=716"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/categories?post=716"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/tags?post=716"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}