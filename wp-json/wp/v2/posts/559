"background-color":"var(--ast-global-color-4)","background-image":"","background-repeat":"repeat","background-position":"center center","background-size":"auto","background-attachment":"scroll","background-type":"","background-media":"","overlay-type":"","overlay-color":"","overlay-opacity":"","overlay-gradient":""}},"footnotes":""},"categories":[1],"tags":[],"class_list":["post-559","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-uncategorized"],"_links":{"self":[{"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/posts\/559","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/comments?post=559"}],"version-history":[{"count":2,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/posts\/559\/revisions"}],"predecessor-version":[{"id":985,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/posts\/559\/revisions\/985"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/media\/190"}],"wp:attachment":[{"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/media?parent=559"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/categories?post=559"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/dev-blogjessica.pantheonsite.io\/wp-json\/wp\/v2\/tags?post=559"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}