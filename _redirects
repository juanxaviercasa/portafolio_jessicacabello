# Redirecciones Cloudflare Pages. Las reglas de estado 404 en _redirects
# no estan soportadas; Pages entrega /404.html nativamente.
# No servir en el dominio los borradores que GitHub Actions publicara mas adelante.
/_queue/*       /blog/  302

/wp-login.php    /    301
/wp-admin/*      /    301

# Normalizar categorías antiguas.
/category/uncategorized    /blog/    301
/category/uncategorized/   /blog/    301
/category/uncategorized/*  /blog/    301
